# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/velocity

# JWT Authentication
# In production, use a strong 256-bit random string (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI Microservice (Python Flask)
AI_SERVICE_URL=http://localhost:8001

# Google Gemini API
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Apify Lead Sourcing Actor
# Obtain from https://console.apify.com/
APIFY_TOKEN=your_apify_token_here

# Email Delivery (Nodemailer / SMTP) for Candidate Exam Invitations
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Velocity Recruitment <noreply@example.com>"

# Public Candidate Exam Portal Base URL
EXAM_BASE_URL=http://localhost:5173

