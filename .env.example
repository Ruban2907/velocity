# =================================================================
# Velocity Platform - Docker Environment Configuration
# Copy this file to .env before running: docker compose up --build
# =================================================================

# --- Application Ports & URLs ---
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:8080,http://localhost:5173
# Frontend Client API Base URL
# In Docker (Nginx reverse proxy), leave empty to route all API calls to same-origin /api.
# For local non-containerized Vite development, set to http://localhost:3000.
VITE_API_URL=

# --- Authentication ---
# Required: Strong random secret (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# --- Database ---
# Default for Docker Compose internal network
MONGODB_URI=mongodb://mongodb:27017/velocity

# --- Microservices ---
# Internal Docker bridge network URL for Python AI resume parser
AI_SERVICE_URL=http://ai-service:8001

# --- External AI / LLM (Optional for basic flow) ---
# Google Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Candidate Lead Sourcing (Optional) ---
# Apify token: https://console.apify.com/
APIFY_TOKEN=your_apify_token_here

# --- Email Delivery (SMTP) (Optional) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Velocity Recruitment <noreply@example.com>"
